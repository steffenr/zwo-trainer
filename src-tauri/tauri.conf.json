{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zwoTrainer",
  "identifier": "dev.steffenr.zwotrainer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "zwoTrainer",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/steffenr/zwo-trainer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2OEEwMUFCMkE1NDBENjQKUldSa0RWUXFxd0dLQmdwWXpieEoxMTVCYnZaYUo2WTNocy9HKzhza05ra3FaTTBWNElmNVZYcVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthcareAndFitness",
    "shortDescription": "Indoor trainer for Zwift .zwo workouts and plans",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "copyright": "© 2026 SteffenR",
    "publisher": "SteffenR",
    "license": "MIT",
    "homepage": "https://steffenr.github.io/zwo-trainer/",
    "linux": {
      "deb": {
        "depends": [
          "bluez"
        ]
      },
      "rpm": {
        "depends": [
          "bluez"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
